# Application environment
APP_ENV=production

# Base URL for the application (used for emails and redirects)
BASE_URL=https://portal.example.com
# PUBLIC_BASE_URL is the public-facing URL used to construct shareable
# and user-visible links. BASE_URL is the canonical internal URL used for
# server-side redirects and emails; set both consistently when they match.
PUBLIC_BASE_URL=https://portal.example.com

# Mobile app handoff / store links
APP_DEEP_LINK_SCHEME=
APP_UNIVERSAL_LINK_BASE=
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=
SHOW_OPEN_APP_BANNER=false

# Database connection settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nixor_portal
DB_USER=nixor_user
DB_PASS=

# SMTP settings (PHPMailer). SMTP is used only for explicit transactional
# emails such as password reset, password setup, and one-off consent requests.
MAIL_TRANSPORT=smtp
AUTOMATED_EMAILS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME="Nixor Portal"
SMTP_SECURE=tls

# Google OAuth client config
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dedicated HMAC key for Google OAuth state signing. Generate a long random value.
# If omitted, the app falls back to APP_KEY and then GOOGLE_CLIENT_SECRET.
# Example: OAUTH_STATE_SECRET=9f3d7a4c2e6b4a8d91c0f4b6e2a8d7c9f1b3e5a7c9d0e2f4a6b8c1d3e5f7a9b0
OAUTH_STATE_SECRET=
GOOGLE_REDIRECT_URI=https://portal.example.com/api/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=
# Optional. Requires GOOGLE_ALLOWED_DOMAIN. When true, first Google login creates
# an active volunteer user if no local user exists for the verified domain email.
GOOGLE_AUTO_PROVISION=false

# Shared secret for Panapticon/Nixor Connect server-to-server entitlement checks.
# Generate a long random value and configure the same value in Panapticon.
NCP_API_SHARED_SECRET=
MOBILE_AUTH_REDIRECT_URI=ncp://auth/callback
MOBILE_SESSION_TTL_DAYS=30

# Upload storage (absolute path outside web root)
UPLOAD_PATH=/home/username/portal_uploads

# Log storage path (absolute path)
LOG_PATH=/home/username/portal_logs

# Cron token for web-triggered cron (optional)
CRON_TOKEN=

# Trusted proxies (comma-separated IPs)
TRUSTED_PROXIES=

# Allowed hosts for base URL construction (comma-separated)
ALLOWED_HOSTS=

# Realtime settings
WS_URL=
WS_TOKEN=
POLL_INTERVAL=8

# Device push notifications
# Device push notifications. Leave PUSH_PROVIDER=none until production
# credentials or a trusted relay webhook are configured.
# `PUSH_REGISTRATION_ENABLED` controls whether clients are allowed to
# register device tokens (they may be collected even when delivery is
# disabled). `PUSH_PROVIDER` determines delivery; setting
# `PUSH_PROVIDER=none` disables sending but does not prevent registration.
PUSH_REGISTRATION_ENABLED=true
PUSH_PROVIDER=none
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_SECRET=
FCM_WEBHOOK_URL=
# Note: `FCM_SERVER_KEY` (when forwarded) is the legacy FCM HTTP key, not
# the newer OAuth2-based server credentials. Do not point `FCM_WEBHOOK_URL`
# directly at fcm.googleapis.com; instead use a relay that accepts the legacy
# `Authorization: key=` header or migrate to FCM HTTP v1 with OAuth2 Bearer tokens.
FCM_SERVER_KEY=
