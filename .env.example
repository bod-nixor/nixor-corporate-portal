# Application environment (local, staging, production)
APP_ENV=production
SETUP_TOKEN=

# Base URL for the application
BASE_URL=https://portal.example.com
PUBLIC_BASE_URL=https://portal.example.com

# Mobile app handoff / store links
APP_DEEP_LINK_SCHEME=
APP_UNIVERSAL_LINK_BASE=
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=
SHOW_OPEN_APP_BANNER=false

# Database connection settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nixor_portal
DB_USER=nixor_user
DB_PASS=

# SMTP settings
# SMTP is used only for explicit transactional emails such as password reset,
# password setup, and one-off consent requests.
MAIL_TRANSPORT=smtp
AUTOMATED_EMAILS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME="Nixor Portal"
SMTP_SECURE=tls

# Google OAuth client settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ALLOWED_DOMAIN=nixorcollege.edu.pk
# Optional. Requires GOOGLE_ALLOWED_DOMAIN. When true, first Google login creates
# an active volunteer user if no local user exists for the verified domain email.
GOOGLE_AUTO_PROVISION=false

# Shared secret for Panapticon/Nixor Connect server-to-server entitlement checks.
# Generate an independent value of at least 32 printable ASCII characters and configure the same value in Panapticon.
NCP_API_SHARED_SECRET=

# Durable NCP -> Panapticon entitlement change delivery.
CONNECT_ENTITLEMENT_WEBHOOK_URL=https://api.example.com/internal/ncp/entitlements/changed
CONNECT_ENTITLEMENT_WEBHOOK_SECRET=
CONNECT_ENTITLEMENT_WEBHOOK_MAX_ATTEMPTS=10
CONNECT_ENTITLEMENT_WEBHOOK_LEASE_SECONDS=600
CONNECT_ENTITLEMENT_RECONCILIATION_BATCH_SIZE=250

# Mobile bearer sessions. Raw tokens are returned once to native clients; only
# SHA-256 token hashes are stored server-side.
MOBILE_SESSION_TTL_DAYS=30

# Upload storage path (absolute, outside web root)
UPLOAD_PATH=/home/username/portal_uploads

# Log storage path (absolute)
LOG_PATH=/home/username/portal_logs

# Cron token for web-triggered cron
CRON_TOKEN=

# Trusted proxies (comma-separated IPs)
TRUSTED_PROXIES=

# Allowed hosts for base URL construction (comma-separated)
ALLOWED_HOSTS=

# Session cookie settings (override defaults if needed)
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=

# Dev-only seed guard (requires APP_ENV=development)
ALLOW_DEV_SEED=false

# WebSocket queue file path (relative to project root)
WS_QUEUE_FILE=./ws/events.queue

# WebSocket server URL for client connections (optional)
WS_URL=
WS_TOKEN=
POLL_INTERVAL=8

# Device push notifications. Leave PUSH_PROVIDER=none until production
# credentials or a trusted relay webhook are configured.
PUSH_REGISTRATION_ENABLED=true
PUSH_PROVIDER=none
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_SECRET=
# Note: The `FCM_SERVER_KEY` forwarded when using `FCM_WEBHOOK_URL` is the
# legacy FCM HTTP key. Do not point `FCM_WEBHOOK_URL` directly at
# fcm.googleapis.com (that will usually return 401). Use a relay that accepts
# the legacy key format or migrate to the FCM HTTP v1 API with OAuth2 Bearer
# tokens for direct Google integration.
FCM_WEBHOOK_URL=
FCM_SERVER_KEY=
